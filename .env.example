# Application environment: dev | prod | stg
# Note this is NOT Node's development/production convention.
NODE_ENV=dev

# Port the HTTP server listens on
PORT=3000

# PostgreSQL connection string used by Drizzle and drizzle-kit.
# Matches the credentials in docker/db.compose.yml, so `pnpm db:up` just works.
DATABASE_URL=postgres://primer:primer@localhost:5432/express_primer

# Log level: error | warn | info | http | verbose | debug | silly
# Defaults to debug when NODE_ENV=dev, info otherwise.
LOG_LEVEL=debug

# Demonstrates the boot-time config guard in src/config/example.config.ts.
# Setting it with NODE_ENV=prod is a boot error. Removed by `pnpm examples:remove`.
EXAMPLE_FEATURE_ENABLED=false
